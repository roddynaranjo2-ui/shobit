<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView style="@style/NexoCardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/choose_app_question" />
    <TextView style="@style/NexoBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="@string/choose_app_hint" android:textSize="12sp" />
    <EditText android:id="@+id/app_search" style="@style/NexoField" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:hint="@string/search_apps" android:inputType="text" android:maxLines="1" />

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_marginTop="10dp" android:layout_weight="1">
        <ListView android:id="@+id/app_list" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@color/nexo_border" android:dividerHeight="1dp" android:scrollbars="vertical" />
        <TextView android:id="@+id/empty_apps" style="@style/NexoBody" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:padding="24dp" android:text="@string/no_apps" android:visibility="gone" />
    </FrameLayout>

    <Button android:id="@+id/cancel_picker" style="@style/NexoOutlineButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/cancel" />
</LinearLayout>
