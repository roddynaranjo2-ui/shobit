<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval"><solid android:color="#18241E"/><stroke android:width="2dp" android:color="#42594D"/></shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval"><solid android:color="#244733"/><stroke android:width="3dp" android:color="@color/nexo_green"/></shape>
    </item>
    <item>
        <shape android:shape="oval"><solid android:color="#14271C"/><stroke android:width="3dp" android:color="@color/nexo_green"/></shape>
    </item>
</selector>
